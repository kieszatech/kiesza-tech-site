{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {"source": "/route/:path*", "destination": "/", "permanent": false},
    {"source": "/fleet/:path*", "destination": "/", "permanent": false},
    {"source": "/nav/:path*", "destination": "/", "permanent": false}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
    ]}
  ]
}
